scalar Date

type Query{
    country(id: ID!): Country!
    countries (page: Int, size: Int): CountryConnection

}

type Mutation {
    addCountry(input: CountryInput!): Country!
    updateCountry(input: CountryUpdateInput!): Country!
}

type Country {
    id: ID!,
    name: String!,
    code: String!
}

input CountryInput {
    name: String!,
    code: String!
}

input CountryUpdateInput {
    id: ID!
    name: String,
    code: String
}

